# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Backend API base URL.
#
# The VITE_ prefix is required: Vite exposes only variables starting with it,
# and everything else in the environment stays out of the bundle. This replaced
# REACT_APP_API_BASE_URL when the project moved off create-react-app.
VITE_API_BASE_URL=http://localhost:8081/api
